# Copy this file to .env and fill in your own bot token.
# Never commit .env or share the token in chat.

TELEGRAM_BOT_TOKEN=
APP_TIMEZONE=Asia/Tashkent

# Public GitHub Pages Mini App URL (must be HTTPS).
MINI_APP_URL=https://nikolaimv77.github.io/happy.github.io/

# Leave empty only while testing: empty means anyone can interact with the bot.
# For a private birthday gift, set this to the recipient's numeric Telegram user ID.
ALLOWED_TELEGRAM_USER_ID=

BIRTHDAY_MONTH=10
BIRTHDAY_DAY=30
BIRTHDAY_HOUR=0
BIRTHDAY_MINUTE=0

# Real birthday sending remains disabled unless deliberately enabled.
ENABLE_REAL_BIRTHDAY_SEND=0
